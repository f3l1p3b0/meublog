body {
    font-family: 'Arial', sans-serif;
    background-color: #121212;
    margin: 0
    padding: 0;
    color: #121212;
}

header, footer {
    background-color: #000;
    color: ccc;
    padding: 20px;
    text-align: center;
}

nav a {
    margin: 0 10px;
    color: white;
    text-decoration: none;
}

.container {
    width: 90%;
    max-width: 900px;
    margin: auto;
    padding: 20px;
    background: white;
    box-shadow: 0 0 10px rgba(0,0,0,0.1);
}

.post {
    border-bottom: 1px solid #ccc;
    margin-bottom: 30px;
    padding-bottom: 20px;
}

img {
    max-width: 100%;
    height: auto;
}

form input[type="text"],
form textarea,
form input[type="file"] {
    width: 100%;
    padding: 10px;
    margin-bottom: 15px;
    border: 1px solid #ccc;
    border-radius: 4px;
}

button {
    background-color: #121212;
    color: white;
    padding: 10px 15px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
}

img {
    max-width: 100%;
    border-radius: 8px;
}
.flash.success { background-color: #d4edda; color: #155724; padding: 10px; margin-bottom: 15px; border-left: 4px solid #28a745; }
.flash.error { background-color: #f8d7da; color: #721c24; padding: 10px; margin-bottom: 15px; border-left: 4px solid #dc3545; }
